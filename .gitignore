# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide/ cli
.idea
.cursor
.continue
.claude

# food embedding catalog: too big to commit (Qwen3-8B = ~129MB).
# Rebuild via `tsx scripts/build-food-embeddings.ts --source=lm-studio`.
# Nomic catalog (~24MB) may be committed.
lib/data/food-embeddings/qwen3-8b.bin

# agent harness telemetry (AGENT_DEBUG_LOG=1 writes JSONL traces here)
.agent-runs/

# Body3D pipeline
body3d/pipeline/.venv/
body3d/pipeline/data/
body3d/pipeline/__pycache__/

/public/body-mock.html.tmp/

# Local scratch + tool artifacts
.tmp/
tmp/
.playwright-mcp/
*.bak
test.txt
