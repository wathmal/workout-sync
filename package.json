{
  "name": "workout-sync",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "prebuild": "npm run refresh:hevy && NODE_OPTIONS=--conditions=react-server tsx scripts/build-catalog-embeddings.ts --source=both --check-or-rebuild",
    "refresh:hevy": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/refresh-hevy-catalog.ts",
    "refresh": "npm run refresh:hevy && NODE_OPTIONS=--conditions=react-server tsx scripts/build-catalog-embeddings.ts --source=both --check-or-rebuild",
    "build:embeddings": "NODE_OPTIONS=--conditions=react-server tsx scripts/build-catalog-embeddings.ts",
    "build:embeddings:both": "NODE_OPTIONS=--conditions=react-server tsx scripts/build-catalog-embeddings.ts --source=both",
    "build:embeddings:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/build-catalog-embeddings.ts --check",
    "e2e:matching": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local tests/e2e/test-matching-e2e.ts",
    "e2e:full": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local tests/e2e/full-e2e.ts",
    "e2e:heic": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local tests/e2e/heic-e2e.ts",
    "debug:match": "NODE_OPTIONS=--conditions=react-server tsx scripts/debug-match.ts",
    "compare:modes": "NODE_OPTIONS=--conditions=react-server tsx scripts/compare-modes.ts",
    "agent:extract": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/agent-extract.ts",
    "body3d:api:setup": "cd tools/body-fit-api && python3.12 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
    "body3d:api": "cd tools/body-fit-api && .venv/bin/python -m uvicorn app:app --port 8000 --host 127.0.0.1",
    "body3d:api:docker": "cd tools/body-fit-api && (command -v docker >/dev/null && docker compose up --build || podman compose up --build)",
    "db:up": "(command -v docker >/dev/null && docker compose up -d db || podman compose up -d db)",
    "db:down": "(command -v docker >/dev/null && docker compose down || podman compose down)",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/seed-food.ts",
    "db:reset": "(command -v docker >/dev/null && docker compose down -v && docker compose up -d db || podman compose down -v && podman compose up -d db) && sleep 2 && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "exifreader": "^4.38.1",
    "groq-sdk": "^0.37.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-zoom-pan-pinch": "^3.7.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jest": "^30.2.0",
    "shadcn": "^3.6.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
